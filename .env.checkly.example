# Local Checkly test values only.
# Copy this file to .env.checkly.local (already ignored by .env*.local).

CHECKLY_BUYER_BASE_URL=https://tradefeed.co.za
CHECKLY_BUYER_SHOP_SLUG=
CHECKLY_BUYER_PRODUCT_REF=
CHECKLY_BUYER_MARKETPLACE_SEARCH=

# Must be a public HTTPS staging/preview origin, never production.
CHECKLY_SELLER_BASE_URL=
CHECKLY_SELLER_EXPECTED_HOST=
CHECKLY_SELLER_SHOP_SLUG=
CHECKLY_SELLER_EMAIL=
CHECKLY_SELLER_MUTATION_ACK=I_UNDERSTAND_THIS_MUTATES_STAGING

# Hostname only, for example example.clerk.accounts.dev.
CHECKLY_CLERK_FRONTEND_API_URL=
CLERK_SECRET_KEY=
