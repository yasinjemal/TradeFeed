# ============================================================
# TradeFeed — Environment Variables
# ============================================================
# NEVER commit this file. It's in .gitignore.
# Copy to .env and fill in real values.
# ============================================================

# Database — PostgreSQL (Supabase, Neon, or local)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/tradefeed

# Clerk Authentication (Phase 3)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""
# CLERK_WEBHOOK_SECRET=""

# Image Upload — Uploadthing CDN (Phase 4)
# Get your token from https://uploadthing.com/dashboard
# UPLOADTHING_TOKEN=""

# PayFast — SA Payment Gateway (Phase 5)
# Get credentials from https://www.payfast.co.za/registration
# PAYFAST_MERCHANT_ID=""
# PAYFAST_MERCHANT_KEY=""
# PAYFAST_PASSPHRASE=""

# Resend — Email Notifications (Phase 10+)
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=""
# Dedicated server-only secret for email consent, suppression, and unsubscribe
# tokens. Generate at least 32 random characters and keep it stable.
# EMAIL_MARKETING_HMAC_SECRET=""
# Explicit marketing-delivery locks. Leave all unset until the provider setup
# is reviewed, the NCC Opt-Out Registry list was cleansed within the last
# 24 hours, and a customer campaign is deliberately enabled.
# EMAIL_MARKETING_PROVIDER_READY="true"
# EMAIL_MARKETING_NCC_CLEANSED_AT="2026-07-31T12:00:00.000Z"
# EMAIL_MARKETING_SEND_ENABLED="true"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional analytics and error telemetry. Analytics vendors still require
# explicit browser consent; Sentry exception reporting remains operational.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Keep GA disabled until Enhanced Measurement is off and live payloads have
# been privacy-reviewed. Set to "true" only after completing that review.
# NEXT_PUBLIC_GA_MEASUREMENT_REVIEWED="true"
# NEXT_PUBLIC_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"
# SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"

# Optional distributed rate limiting.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
# Optional dedicated HMAC secret (32+ random characters); otherwise the
# server-only Upstash token keys pseudonymous rate-limit identifiers.
# RATE_LIMIT_HASH_SECRET=""

# Optional — South Africa address autocomplete in seller settings.
# Keep this server-only; requests are proxied through /api/location/autocomplete.
GEOAPIFY_API_KEY=""

# Optional — Better Stack cron heartbeat URLs (server-only secrets).
# Leave unset to disable; see docs/BETTER_STACK_MONITORING.md.
# BETTER_STACK_HEARTBEAT_DATA_RETENTION_URL=""
# BETTER_STACK_HEARTBEAT_DOMAIN_HEALTH_URL=""
# BETTER_STACK_HEARTBEAT_RANKING_COMPUTATION_URL=""
# BETTER_STACK_HEARTBEAT_SELLER_SEQUENCES_URL=""
# BETTER_STACK_HEARTBEAT_SUBSCRIPTION_EXPIRY_URL=""

# Platform Admin — Comma-separated Clerk user IDs for admin access
# ADMIN_USER_IDS="user_abc123,user_def456"

# Feature Flags — all default OFF (see lib/config/feature-flags.ts)
# NEXT_PUBLIC_FF_WHATSAPP_PRODUCT_IMPORT="true"
# Buyer retention (Phase 1)
# NEXT_PUBLIC_FF_BUYER_ACCOUNTS="true"
# NEXT_PUBLIC_FF_SHOP_FOLLOW="true"
# Trust system (Phase 2)
# NEXT_PUBLIC_FF_TRUST_SYSTEM="true"
# NEXT_PUBLIC_FF_REVIEW_REQUESTS="true"
# AI deepening (Phase 3)
# NEXT_PUBLIC_FF_LISTING_TRANSLATIONS="true"
# NEXT_PUBLIC_FF_PRICE_SUGGESTIONS="true"
# NEXT_PUBLIC_FF_BG_REMOVAL="true"
# Onboarding (Phase 4)
# NEXT_PUBLIC_FF_WA_IMPORT_PRIMARY="true"
# NEXT_PUBLIC_FF_CATALOGUE_IMPORT="true"

# Background Removal (Phase 3) — remove.bg API key
# Get one at https://www.remove.bg/api — graceful no-op when unset
# BG_REMOVAL_API_KEY=""
